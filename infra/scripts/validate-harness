#!/usr/bin/env python3
"""하네스 자체 유효성 검사 (FND, 메타프롬프트 §19).

검사 항목:
  1. .harness/state.json JSON 유효성
  2. .harness/backlog.yaml YAML 유효성
  3. 작업 ID 중복
  4. depends_on이 가리키는 작업 ID가 실제로 존재
  5. .harness/locks.yaml 소유 경로 충돌(동일 경로가 둘 이상 트랙에 배정)
  6. .harness/quality-gates.yaml 필수 항목 존재
  7. status: DONE인 작업에 대응하는 handoff 문서 존재
  8. state.json의 next_recommended_task(s)가 실제로 READY(또는 PENDING_DECOMPOSITION) 상태인지

문제를 찾으면 종료코드 1로 실패하고 문제 목록을 출력한다. 통과하면 "OK"만 출력한다.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    print("ERROR: PyYAML이 필요합니다 (pip install pyyaml)", file=sys.stderr)
    sys.exit(2)

ROOT = Path(__file__).resolve().parents[2]
HARNESS = ROOT / ".harness"

# backlog.yaml의 track 값 -> handoffs/ 하위 디렉터리명 매핑 (worker-prompts.md 기준).
TRACK_TO_HANDOFF_DIR = {
    "FOUNDATION": None,  # 메타프롬프트 원문에 foundation 전용 handoff 디렉터리가 없음 - 검사 생략
    "CONTRACTS": "contracts",
    "BACKEND": "backend",
    "USER_WEB": "user-web",
    "KIOSK": "kiosk",
    "ADMIN": "admin",
    "AI_SEARCH": "ai-search",
    "QA_SECURITY": "qa",
}

DONE_STATUSES = {"DONE"}
READY_STATUSES = {"READY", "PENDING_DECOMPOSITION"}


def fail(problems: list[str]) -> None:
    print(f"FAIL: {len(problems)}건 발견")
    for p in problems:
        print(f"  - {p}")
    sys.exit(1)


def main() -> None:
    problems: list[str] = []

    # 1. state.json
    state_path = HARNESS / "state.json"
    try:
        state = json.loads(state_path.read_text())
    except Exception as exc:  # noqa: BLE001
        fail([f"state.json 파싱 실패: {exc}"])
        return

    # 2. backlog.yaml
    backlog_path = HARNESS / "backlog.yaml"
    try:
        backlog = yaml.safe_load(backlog_path.read_text())
    except Exception as exc:  # noqa: BLE001
        fail([f"backlog.yaml 파싱 실패: {exc}"])
        return

    tasks = backlog.get("tasks", [])
    task_ids = [t["id"] for t in tasks]
    tasks_by_id = {t["id"]: t for t in tasks}

    # 3. 작업 ID 중복
    seen = set()
    for tid in task_ids:
        if tid in seen:
            problems.append(f"중복 task id: {tid}")
        seen.add(tid)

    # 4. depends_on 존재 확인
    for t in tasks:
        for dep in t.get("depends_on", []) or []:
            if dep not in tasks_by_id:
                problems.append(f"{t['id']}가 존재하지 않는 의존 작업 참조: {dep}")

    # 5. locks.yaml 소유 경로 충돌
    locks_path = HARNESS / "locks.yaml"
    try:
        locks = yaml.safe_load(locks_path.read_text())
    except Exception as exc:  # noqa: BLE001
        problems.append(f"locks.yaml 파싱 실패: {exc}")
        locks = {"ownership": {}}

    path_owner: dict[str, str] = {}
    for track, paths in locks.get("ownership", {}).items():
        for p in paths or []:
            if p in path_owner and path_owner[p] != track:
                problems.append(
                    f"locks.yaml 경로 충돌: '{p}'가 {path_owner[p]}와 {track} 둘 다에 배정됨"
                )
            path_owner[p] = track

    # 6. quality-gates.yaml 필수 항목
    gates_path = HARNESS / "quality-gates.yaml"
    try:
        gates = yaml.safe_load(gates_path.read_text())
    except Exception as exc:  # noqa: BLE001
        problems.append(f"quality-gates.yaml 파싱 실패: {exc}")
        gates = {"gates": {}}

    for gate_name, gate_def in gates.get("gates", {}).items():
        if "status" not in gate_def:
            problems.append(f"quality-gates.yaml의 {gate_name}에 status 필드 없음")
        if "criteria" not in gate_def:
            problems.append(f"quality-gates.yaml의 {gate_name}에 criteria 필드 없음")

    # 7. DONE 작업의 handoff 존재 확인
    for t in tasks:
        if t.get("status") in DONE_STATUSES:
            track = t.get("track")
            handoff_dir = TRACK_TO_HANDOFF_DIR.get(track)
            if handoff_dir is None:
                continue  # FOUNDATION 등 handoff 디렉터리가 정의되지 않은 트랙은 검사 생략
            # 정확히 {id}.md 하나만 요구하지 않는다 - 여러 하위작업을 한 번에
            # 처리한 경우 {id}-부분명.md, {id}부터 시작하는 결합 파일명(예:
            # CTR-002-through-008.md, AIS-001-005-006.md)도 유효한 handoff로
            # 인정한다 - 파일 존재 여부가 아니라 "이 작업에 대한 기록이 있는가"가
            # 중요하다.
            handoff_dir_path = HARNESS / "handoffs" / handoff_dir
            candidates = list(handoff_dir_path.glob(f"{t['id']}*.md")) if handoff_dir_path.is_dir() else []
            if not candidates:
                problems.append(
                    f"{t['id']}(DONE)에 대응하는 handoff 문서 없음: "
                    f"{handoff_dir_path.relative_to(ROOT)}/{t['id']}*.md"
                )

    # 8. next_recommended_task(s)가 실제 READY인지
    next_tasks = state.get("next_recommended_tasks")
    if next_tasks is None:
        single = state.get("next_recommended_task")
        next_tasks = [single] if single else []
    for nid in next_tasks:
        t = tasks_by_id.get(nid)
        if t is None:
            problems.append(f"next_recommended_task(s)가 존재하지 않는 작업을 가리킴: {nid}")
        elif t.get("status") not in READY_STATUSES:
            problems.append(
                f"next_recommended_task(s)의 {nid}가 READY 상태가 아님 (현재: {t.get('status')})"
            )

    if problems:
        fail(problems)
    print(f"OK: {len(tasks)}개 작업, {len(gates.get('gates', {}))}개 게이트, "
          f"{len(path_owner)}개 소유 경로 - 문제 없음")


if __name__ == "__main__":
    main()
