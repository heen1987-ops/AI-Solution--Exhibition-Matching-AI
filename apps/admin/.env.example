# apps/admin environment variables (Wave 1 skeleton - display only, no real API calls yet)

# Display name shown in the nav bar / health screen.
NEXT_PUBLIC_ADMIN_APP_NAME="백주대간 관리자"

# Deployment environment label (local | staging | production). Display only.
NEXT_PUBLIC_ENVIRONMENT=local

# Backend API base URL. Not called yet this wave - the shared contract
# (.harness/contracts/openapi.yaml) is still a 0.0.0-draft stub (G1_CONTRACT_FREEZE
# not reached). Kept here so the wiring point is documented ahead of Wave 2
# (ADM-GROUP-001).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Contract/schema version this build was scaffolded against. Update once
# CTR-002 (OpenAPI) is frozen.
NEXT_PUBLIC_CONTRACT_VERSION=0.0.0-draft
