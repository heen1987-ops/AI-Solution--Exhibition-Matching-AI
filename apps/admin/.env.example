# apps/admin environment variables.

# Display name shown in the nav bar / health screen.
NEXT_PUBLIC_ADMIN_APP_NAME="백주대간 관리자"

# Deployment environment label (local | staging | production). Display only.
NEXT_PUBLIC_ENVIRONMENT=local

# Backend API base URL. /console uses this for admin operation calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local admin headers. Do not put real production secrets in NEXT_PUBLIC values.
NEXT_PUBLIC_ADMIN_USER_ID=
NEXT_PUBLIC_ADMIN_ACTOR_ROLE=OPERATOR

# Server-side names can be used by deployments that proxy admin actions.
MEETAI_API_BASE_URL=http://localhost:8000
MEETAI_ADMIN_USER_ID=
MEETAI_ADMIN_ACTOR_ROLE=OPERATOR

# Contract/schema version this build targets.
NEXT_PUBLIC_CONTRACT_VERSION=1.0.0
