        sa.ForeignKeyConstraint(
            ["tenant_id", "event_id", "zone_id"],
            [
                "exhibition.event_zone.tenant_id",
                "exhibition.event_zone.event_id",
                "exhibition.event_zone.event_zone_id",
            ],
            name="fk_program_zone_same_event",
        ),
        sa.CheckConstraint(
            "start_at IS NULL OR end_at IS NULL OR start_at < end_at",
            name="time_range",
        ),
        sa.CheckConstraint("capacity IS NULL OR capacity >= 0", name="capacity_nonneg"),
        sa.CheckConstraint(
            f"status IN ({_in_list(PROGRAM_STATUSES)})", name="status_allowed"
        ),
        schema=SCHEMA,
    )

    # ------------------------------------------------------------------
    # 9. 08 문서 27절 공급 프로파일 확장 테이블
