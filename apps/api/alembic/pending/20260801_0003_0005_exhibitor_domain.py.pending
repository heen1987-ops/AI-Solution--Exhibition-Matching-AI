            "consumer_completeness", sa.Numeric(5, 2), nullable=False, server_default="0"
        ),
        sa.Column(
            "buyer_completeness", sa.Numeric(5, 2), nullable=False, server_default="0"
        ),
        sa.Column("current_version", sa.Integer(), nullable=False, server_default="1"),
