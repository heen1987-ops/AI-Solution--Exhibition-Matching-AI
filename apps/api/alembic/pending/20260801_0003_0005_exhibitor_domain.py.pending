    op.create_table(
        "buyer_preference",
        _uuid("exhibitor_buyer_preference_id", primary_key=True),
        _uuid("exhibitor_id"),
        _uuid("taxonomy_version_id"),
        _uuid("buyer_type_concept_id", nullable=True),
        _uuid("channel_concept_id", nullable=True),
        _uuid("region_concept_id", nullable=True),
        sa.Column("volume_min", sa.Integer(), nullable=True),
        sa.Column("volume_max", sa.Integer(), nullable=True),
        sa.Column(
            "preference_level",
            sa.String(20),
            nullable=False,
            server_default="PREFERRED",
        ),
        sa.Column(
            "active", sa.Boolean(), nullable=False, server_default=sa.text("true")
        ),
        _created_at(),
        _updated_at(),
        sa.ForeignKeyConstraint(
            ["exhibitor_id"],
            ["exhibition.exhibitor.exhibitor_id"],
            name="fk_buyer_preference_exhibitor_id_exhibitor",
        ),
        _ontology_fk(
            ["taxonomy_version_id", "buyer_type_concept_id"],
            "fk_buyer_preference_buyer_type_ontology_revision",
        ),
        _ontology_fk(
            ["taxonomy_version_id", "channel_concept_id"],
            "fk_buyer_preference_channel_ontology_revision",
        ),
        _ontology_fk(
            ["taxonomy_version_id", "region_concept_id"],
            "fk_buyer_preference_region_ontology_revision",
        ),
        sa.CheckConstraint(
            "num_nonnulls(buyer_type_concept_id, channel_concept_id, region_concept_id) >= 1",
            name="at_least_one_dimension",
        ),
        sa.CheckConstraint(
            "volume_min IS NULL OR volume_min >= 0", name="volume_min_nonneg"
        ),
        sa.CheckConstraint(
            "volume_max IS NULL OR volume_max >= 0", name="volume_max_nonneg"
        ),
        sa.CheckConstraint(
            "volume_min IS NULL OR volume_max IS NULL OR volume_min <= volume_max",
            name="volume_order",
        ),
        sa.CheckConstraint(
            f"preference_level IN ({_in_list(BUYER_PREFERENCE_LEVELS)})",
            name="preference_level_allowed",
        ),
        schema=SCHEMA,
    )

    op.create_table(
        "profile_attribute",
        _uuid("supply_attribute_id", primary_key=True),
        sa.Column("object_type", sa.String(20), nullable=False),
        _uuid("object_id"),
        _uuid("taxonomy_version_id"),
        _uuid("concept_id"),
        sa.Column("attribute_code", sa.String(100), nullable=False),
        sa.Column("value_json", postgresql.JSONB(astext_type=sa.Text()), nullable=False),
        sa.Column("source_type", sa.String(30), nullable=False),
        sa.Column(
            "verification_status",
            sa.String(20),
            nullable=False,
            server_default="SELF_DECLARED",
        ),
        sa.Column(
            "confidence", sa.Numeric(4, 3), nullable=False, server_default="1"
        ),
        sa.Column("visibility", sa.String(30), nullable=False, server_default="PUBLIC"),
        sa.Column("valid_from", sa.DateTime(timezone=True), nullable=True),
        sa.Column("valid_until", sa.DateTime(timezone=True), nullable=True),
        sa.Column(
            "active", sa.Boolean(), nullable=False, server_default=sa.text("true")
        ),
        _created_at(),
        _ontology_fk(
            ["taxonomy_version_id", "concept_id"],
            "fk_supply_profile_attribute_ontology_revision",
        ),
        sa.CheckConstraint(
            f"object_type IN ({_in_list(SUPPLY_ATTRIBUTE_OBJECT_TYPES)})",
            name="object_type_allowed",
        ),
        sa.CheckConstraint(
            f"source_type IN ({_in_list(SUPPLY_SOURCE_TYPES)})",
            name="source_type_allowed",
        ),
        sa.CheckConstraint(
            f"verification_status IN ({_in_list(VERIFICATION_STATUSES)})",
            name="verification_status_allowed",
        ),
        sa.CheckConstraint(
            "confidence >= 0 AND confidence <= 1", name="confidence_range"
        ),
        sa.CheckConstraint(
            f"visibility IN ({_in_list(VISIBILITY_LEVELS)})", name="visibility_allowed"
        ),
        sa.CheckConstraint(
            "valid_from IS NULL OR valid_until IS NULL OR valid_from <= valid_until",
            name="valid_period_order",
        ),
        schema=SCHEMA,
    )
    op.create_index(
        "ix_supply_profile_attribute_lookup",
        "profile_attribute",
        ["object_type", "object_id", "taxonomy_version_id", "concept_id", "active"],
        schema=SCHEMA,
    )


def downgrade() -> None:
    for table in (
        "profile_attribute",
        "buyer_preference",
        "supply_capability",
        "product_profile",
        "exhibitor_profile",
        "program",
        "booth_qr",
        "booth_status_history",
        "booth",
        "trade_condition_term",
        "trade_condition",
        "product_image",
        "product_attribute",
        "event_product",
        "product",
        "staff_topic",
        "exhibitor_staff",
        "participation_category",
        "exhibitor_participation",
        "exhibitor_business_type",
        "exhibitor",
    ):
        op.drop_table(table, schema=SCHEMA)
