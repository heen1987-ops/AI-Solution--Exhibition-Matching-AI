    # ------------------------------------------------------------------
    # 7. booth + booth_status_history + booth_qr (db-erd 13.1)
    # ------------------------------------------------------------------
    op.create_table(
        "booth",
        _uuid("booth_id", primary_key=True),
        _uuid("tenant_id"),
        _uuid("event_id"),
        _uuid("participation_id"),
        _uuid("zone_id", nullable=True),
        sa.Column("booth_number", sa.String(30), nullable=False),
        sa.Column("map_x", sa.Numeric(10, 3), nullable=True),
        sa.Column("map_y", sa.Numeric(10, 3), nullable=True),
        sa.Column(
            "operating_status", sa.String(20), nullable=False, server_default="CLOSED"
        ),
        sa.Column(
            "congestion_level", sa.String(20), nullable=False, server_default="UNKNOWN"
        ),
        sa.Column("estimated_wait_minutes", sa.Integer(), nullable=True),
        sa.Column("status_observed_at", sa.DateTime(timezone=True), nullable=True),
        sa.Column("row_version", sa.BigInteger(), nullable=False, server_default="1"),
        _created_at(),
        _updated_at(),
        sa.ForeignKeyConstraint(
            ["tenant_id", "event_id"],
            ["exhibition.event.tenant_id", "exhibition.event.event_id"],
            name="fk_booth_event_boundary",
        ),
        sa.ForeignKeyConstraint(
            ["tenant_id", "event_id", "zone_id"],
            [
                "exhibition.event_zone.tenant_id",
                "exhibition.event_zone.event_id",
                "exhibition.event_zone.event_zone_id",
            ],
            name="fk_booth_zone_same_event",
        ),
        sa.ForeignKeyConstraint(
            ["participation_id"],
            ["exhibition.exhibitor_participation.participation_id"],
            name="fk_booth_participation_id_exhibitor_participation",
        ),
        sa.UniqueConstraint(
            "event_id", "booth_number", name="uq_booth_event_number"
        ),
        sa.CheckConstraint(
            f"operating_status IN ({_in_list(BOOTH_OPERATING_STATUSES)})",
            name="operating_status_allowed",
        ),
        sa.CheckConstraint(
            f"congestion_level IN ({_in_list(BOOTH_CONGESTION_LEVELS)})",
            name="congestion_level_allowed",
        ),
        sa.CheckConstraint(
            "estimated_wait_minutes IS NULL OR estimated_wait_minutes >= 0",
            name="estimated_wait_minutes_nonneg",
        ),
        schema=SCHEMA,
    )
    # db-erd 21절 idx_booth_live.
    op.create_index(
        "idx_booth_live",
        "booth",
        ["event_id", "operating_status", "congestion_level"],
        schema=SCHEMA,
    )

    op.create_table(
        "booth_status_history",
        _uuid("booth_status_history_id", primary_key=True),
