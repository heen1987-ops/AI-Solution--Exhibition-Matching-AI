        sa.ForeignKeyConstraint(
            ["changed_by_user_id"],
            ["profile.user_account.user_id"],
            name="fk_booth_status_history_changed_by_user_id_user_account",
        ),
        sa.CheckConstraint(
            f"previous_status IS NULL OR previous_status IN "
            f"({_in_list(BOOTH_OPERATING_STATUSES)})",
            name="previous_status_allowed",
        ),
        sa.CheckConstraint(
            f"new_status IN ({_in_list(BOOTH_OPERATING_STATUSES)})",
            name="new_status_allowed",
        ),
        schema=SCHEMA,
    )
    op.create_index(
        "ix_booth_status_history_booth_created",
