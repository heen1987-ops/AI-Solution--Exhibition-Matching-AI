        ["booth_id", "created_at"],
        schema=SCHEMA,
    )

    op.create_table(
        "booth_qr",
        _uuid("booth_qr_id", primary_key=True),
        _uuid("booth_id"),
        sa.Column("token_hmac", sa.LargeBinary(), nullable=False),
        sa.Column("valid_from", sa.DateTime(timezone=True), nullable=True),
        sa.Column("valid_until", sa.DateTime(timezone=True), nullable=True),
        sa.Column("status", sa.String(20), nullable=False, server_default="ACTIVE"),
        sa.Column("key_version", sa.Integer(), nullable=False, server_default="1"),
        _created_at(),
        sa.ForeignKeyConstraint(
            ["booth_id"],
            ["exhibition.booth.booth_id"],
            name="fk_booth_qr_booth_id_booth",
        ),
        sa.UniqueConstraint("token_hmac", name="uq_booth_qr_token_hmac"),
        sa.CheckConstraint(
            f"status IN ({_in_list(BOOTH_QR_STATUSES)})", name="status_allowed"
        ),
        sa.CheckConstraint(
            "valid_from IS NULL OR valid_until IS NULL OR valid_from < valid_until",
            name="valid_period_order",
        ),
        sa.CheckConstraint("key_version >= 1", name="key_version_positive"),
        schema=SCHEMA,
    )

    # ------------------------------------------------------------------
    # 8. program (db-erd 13.2)
    # ------------------------------------------------------------------
    op.create_table(
        "program",
        _uuid("program_id", primary_key=True),
        _uuid("tenant_id"),
        _uuid("event_id"),
        _uuid("zone_id", nullable=True),
