# apps/api/.env.example
# 로컬 개발용 예시. 실제 값은 apps/api/.env로 복사한 뒤 채운다 (.env는 커밋하지 않는다).

ENV=local
DEBUG=true

# SQLAlchemy 2.0 async + asyncpg 드라이버 형식 (postgresql+asyncpg://)
# 아래 값은 repo 루트 docker-compose.yml의 기본값(POSTGRES_DB/USER/PASSWORD=backju)과 맞춘 예시다.
DATABASE_URL=postgresql+asyncpg://backju:backju@localhost:5432/backju
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# 콤마(,)로 구분된 허용 origin 목록. 기본값 "*"는 개발 전용 전체 허용이다.
CORS_ORIGINS=*

# 세션 서명·HMAC 등에 사용. 운영 환경에서는 반드시 무작위 값으로 교체한다.
SECRET_KEY=change-me-in-production
SITE_CONTEXT_SECRET=change-me-separately-in-production

# 공개 검색 결과 Redis 보존 시간(초)
SEARCH_SESSION_TTL_SECONDS=900

# 익명 현장 키오스크 설정. 세션 타임아웃은 60~120초 범위여야 한다.
KIOSK_EVENT_ID=11111111-1111-4111-8111-111111111111
KIOSK_EVENT_NAME=2026 대한민국 백주대간
KIOSK_DEFAULT_LANGUAGE=ko
KIOSK_SUPPORTED_LANGUAGES=ko,en,ja,zh
KIOSK_ZONE_ID=entrance-a
KIOSK_SESSION_TIMEOUT_SECONDS=90
KIOSK_QR_EXPIRATION_MINUTES=30
KIOSK_PRIMARY_COLOR=#7A2432
GUEST_WEB_BASE_URL=http://localhost:3000
