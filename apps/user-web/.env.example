# apps/user-web/.env.example - 웹 초개인화 모듈 프런트엔드 환경변수.
# 루트 .env.example의 값 규약을 그대로 따른다. 실제 비밀값은 없다(로컬 기본값).
#
# WEB-GROUP-001 이후 화면은 아래 API_BASE_URL로 백엔드 API를 우선 호출하고,
# 로컬 백엔드가 없거나 인증 컨텍스트가 부족하면 같은 UI 타입의 fallback 데이터를 표시한다.

# 백엔드(backend/) API 기본 주소. 브라우저에 노출되는 값이므로 개인정보·비밀값을 넣지 않는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 로컬 개발용 공개 컨텍스트 헤더. 비밀값이나 실사용 개인정보를 넣지 않는다.
NEXT_PUBLIC_MEETAI_PROFILE_ID=
NEXT_PUBLIC_MEETAI_USER_ID=
NEXT_PUBLIC_MEETAI_USER_TYPE=GENERAL_REGISTERED
NEXT_PUBLIC_MEETAI_ACTOR_ROLE=VISITOR
NEXT_PUBLIC_MEETAI_EVENT_ID=

# 서버 사이드 실행 환경에서는 공개 변수 대신 아래 이름을 사용할 수 있다.
MEETAI_API_BASE_URL=http://localhost:8000
MEETAI_PROFILE_ID=
MEETAI_USER_ID=
MEETAI_USER_TYPE=GENERAL_REGISTERED
MEETAI_ACTOR_ROLE=VISITOR
MEETAI_EVENT_ID=

# 프런트 표시용 환경 라벨 (local/staging/production 등). /health 화면에서 사용한다.
NEXT_PUBLIC_APP_ENV=local
