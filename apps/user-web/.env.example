# 백엔드 API 오리진 (프로토콜 포함, 끝에 슬래시 없이).
# frontend/lib/api-client.ts가 이 값 뒤에 /api/v1 접두사를 붙여 호출한다
# (docs/frontend-backend-ai-interface-spec.md 4.1절).
#
# 예: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# 프론트엔드와 백엔드를 같은 오리진(리버스 프록시 등)으로 배포한다면 빈 값으로 두면
# api-client가 상대경로(/api/v1/...)로 호출한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 검색·추천 대상 행사 UUID. 배포 시 실제 event.id로 반드시 교체한다.
NEXT_PUBLIC_EVENT_ID=00000000-0000-0000-0000-000000000000

# 네이버 클라우드 Maps > Web Dynamic Map의 공개용 ncpKeyId.
# 네이버 클라우드 콘솔에서 실제 서비스 도메인과 로컬 검수 URL을 Web 서비스 URL로 등록한다.
# Client Secret/API Secret은 NEXT_PUBLIC 변수나 프론트엔드 코드에 절대 넣지 않는다.
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=

# 운영 발송 전 개인화 화면 검수용 로컬 데이터. 실제 연락처·이메일·Magic Link 토큰은 넣지
# 않고 maskedPhone에는 마스킹된 값만 쓴다. 값이 없으면 검증된 세션의 실제 프로필/Snapshot을
# 조회하며, 이 미리보기는 외부 발송이나 서버 저장을 수행하지 않는다.
# NEXT_PUBLIC_PERSONALIZATION_PREVIEW_JSON={"displayName":"테스트 사용자","maskedPhone":"010-****-0000","registeredAt":"2026-08-03 16:53:02","sourceLabel":"온라인 사전등록","interests":["우리술"],"goals":["현장구매"],"needsReview":true,"notificationConsent":true,"recommendations":[]}
NEXT_PUBLIC_PERSONALIZATION_PREVIEW_JSON=
