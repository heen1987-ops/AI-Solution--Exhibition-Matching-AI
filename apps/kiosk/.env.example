# 백엔드 API 오리진 (프로토콜 포함, 끝에 슬래시 없이). lib/api-client.ts가 이 값 뒤에
# /api/v1 접두사를 붙여 호출한다.
# 예: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 키오스크와 백엔드를 같은 오리진(리버스 프록시 등)으로 배포한다면 빈 값으로 두면
# api-client가 상대경로(/api/v1/...)로 호출한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 이 브라우저가 물리적으로 어떤 키오스크 단말인지 식별하는 값 (개인정보 아님).
# GET /kiosk/config/{kiosk_id} 경로 파라미터로 쓰인다 (운영자가 단말별로 다르게 설정).
NEXT_PUBLIC_KIOSK_ID=kiosk_a01
