# apps/kiosk - 환경변수 예시. 실제 값은 .env.local에 채우고 커밋하지 않는다.
# 키오스크는 회원가입/로그인/장기 프로파일이 없으므로 인증 관련 환경변수(JWT 시크릿 등)가 없다.

# 공통 백엔드(backend/, BAC-001 /health/live, /health/ready, /api/v1/system/info) 베이스 URL.
# /health 화면(연결상태 점검)과 이후 웨이브의 실제 검색 API 연동에 사용한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 이 키오스크 디바이스가 설치된 물리적 구역(zone) 식별자.
# K-1 §2: 위치는 세션마다 다시 묻지 않고 디바이스 설정에 고정된 값을 사용한다.
NEXT_PUBLIC_KIOSK_DEVICE_ZONE=HALL-A-1

# 이 키오스크 디바이스 고유 식별자(발급 방식은 K-7에서 상세화, 이번 웨이브는 자리표시자).
NEXT_PUBLIC_KIOSK_DEVICE_ID=kiosk-demo-001

# 세션 자동 초기화(대기화면 복귀)까지의 유휴 시간(ms).
# K-1 §4 근거: GuestSession.expires_at을 짧은 TTL로 둔다(초~분 단위). 기본 90초.
# 허용 범위 60000~120000(초 60~120초) - worker-prompts.md 핵심 제약과 일치시킨다.
NEXT_PUBLIC_KIOSK_IDLE_TIMEOUT_MS=90000

# 언어 선택 화면(K-S2)에서 제공할 언어 코드 목록(쉼표 구분). 이번 웨이브는 하드코딩 기본값.
NEXT_PUBLIC_KIOSK_SUPPORTED_LANGUAGES=ko,en,ja,zh
