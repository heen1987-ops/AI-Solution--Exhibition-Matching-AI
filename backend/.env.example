# backend/.env.example
# 로컬 개발용 예시. 실제 값은 backend/.env로 복사한 뒤 채운다 (.env는 git에 커밋하지 않는다).

ENV=local
DEBUG=true

# SQLAlchemy 2.0 async + asyncpg 드라이버 형식 (postgresql+asyncpg://)
# 아래 값은 repo 루트 docker-compose.yml의 기본값(POSTGRES_DB/USER/PASSWORD=backju)과 맞춘 예시다.
DATABASE_URL=postgresql+asyncpg://backju:backju@localhost:5432/backju
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# S3 호환 Object Storage (로컬은 docker-compose.yml의 MinIO). 업체자료 원본
# 저장(ai.source_document, docs/redesign-v2/common/C-2-content-collection-ai-structuring.md)에
# 사용 예정 - 이번 Wave에서는 연결 설정만, 실제 업로드 로직은 아직 없다.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=backju-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# 콤마(,)로 구분된 허용 origin 목록. 기본값 "*"는 개발 전용 전체 허용이다.
CORS_ORIGINS=*

# 세션 서명·HMAC 등에 사용. 운영 환경에서는 반드시 무작위 값으로 교체한다.
SECRET_KEY=change-me-in-production

# /health/ready에서 MinIO 장애를 전체 실패로 처리할지 여부(§11). 기본값 false =
# MinIO 장애는 경고만 하고 PostgreSQL/Redis만 정상이면 ready=true를 유지한다.
READY_CHECK_FAILS_ON_S3_DOWN=false
