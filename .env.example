# 루트 .env.example - 전체 로컬 인프라(docker-compose.yml)가 참조하는 값의 개요.
# 실제 개발용 비밀값은 없다 - 아래는 전부 로컬 전용 기본값이다. 앱별 상세 변수는
# backend/.env.example, apps/user-web/.env.example, apps/kiosk/.env.example,
# apps/admin/.env.example를 각각 참고한다. 운영 배포용 값과 절대 혼동하지 않는다
# (SECURITY.md "시크릿 관리" 참고).

APP_ENV=local

# --- PostgreSQL (docker-compose.yml postgres 서비스) ---
POSTGRES_DB=backju
POSTGRES_USER=backju
POSTGRES_PASSWORD=backju
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://backju:backju@localhost:5432/backju

# --- Redis (docker-compose.yml redis 서비스) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (docker-compose.yml minio 서비스, S3 호환 - 로컬 개발 전용) ---
# 아래 자격정보는 로컬 MinIO 컨테이너 전용 기본값이다. 운영 환경에서는 반드시
# 별도의 관리형 S3 호환 스토리지와 무작위 자격정보를 사용한다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=backju-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- API 기본 주소 ---
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
