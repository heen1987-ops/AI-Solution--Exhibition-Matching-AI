{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meet-ai.local/schemas/matching-golden-set-v1.json",
  "title": "Meet AI Matching Golden Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "golden_set_version",
    "taxonomy_version",
    "policy_versions",
    "thresholds",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "matching-golden-set-v1"},
    "golden_set_version": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "policy_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "buyer", "exhibitor", "reciprocal"],
      "properties": {
        "consumer": {"type": "string", "minLength": 1},
        "buyer": {"type": "string", "minLength": 1},
        "exhibitor": {"type": "string", "minLength": 1},
        "reciprocal": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recall_at_k_min",
        "ndcg_at_k_min",
        "fallback_recall_drop_max",
        "hard_filter_violations_max",
        "filter_decision_mismatches_max",
        "explanation_violations_max",
        "max_exhibitor_share_at_k_max"
      ],
      "properties": {
        "recall_at_k_min": {"type": "number", "minimum": 0, "maximum": 1},
        "ndcg_at_k_min": {"type": "number", "minimum": 0, "maximum": 1},
        "fallback_recall_drop_max": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_filter_violations_max": {"type": "integer", "minimum": 0},
        "filter_decision_mismatches_max": {"type": "integer", "minimum": 0},
        "explanation_violations_max": {"type": "integer", "minimum": 0},
        "max_exhibitor_share_at_k_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "reason_codes"],
      "properties": {
        "passed": {"type": "boolean"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "evidence_refs"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "score_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "maximum"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "maximum": {"type": ["number", "string"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "exhibitor_id",
        "gold_relevance",
        "expected_eligibility",
        "observed_eligibility",
        "recall_channels",
        "allowed_reason_codes",
        "explanations"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "exhibitor_id": {"type": "string", "minLength": 1},
        "gold_relevance": {"type": "integer", "minimum": 0, "maximum": 3},
        "expected_eligibility": {"$ref": "#/$defs/eligibility"},
        "observed_eligibility": {"$ref": "#/$defs/eligibility"},
        "recall_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "explanations": {
          "type": "array",
          "items": {"$ref": "#/$defs/explanation"}
        },
        "components": {"type": "object"},
        "buyer_components": {"type": "object"},
        "exhibitor_components": {"type": "object"},
        "confidence": {"type": ["number", "string", "null"]},
        "buyer_confidence": {"type": ["number", "string", "null"]},
        "exhibitor_confidence": {"type": ["number", "string", "null"]},
        "acceptance_capacity_score": {"type": ["number", "string", "null"]},
        "policy_adjustment": {"type": ["number", "string"]},
        "score_caps": {
          "type": "array",
          "items": {"$ref": "#/$defs/score_cap"}
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "mode", "k", "candidates"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "mode": {
          "enum": ["GENERAL_VISITOR", "BUYER_TO_EXHIBITOR", "RECIPROCAL"]
        },
        "k": {"type": "integer", "minimum": 1, "maximum": 100},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    }
  }
}
